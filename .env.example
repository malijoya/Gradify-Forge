# ---- Local only (admin panel) ----
# Password for /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie
ADMIN_SECRET=replace-with-a-long-random-string

# ---- Live site (set these in Vercel > Settings > Environment Variables) ----
# Contact-form messages are emailed to you through https://resend.com (free plan).
RESEND_API_KEY=
# The inbox that receives inquiries (with Resend's test sender this must be your Resend account email)
CONTACT_TO_EMAIL=
# Optional: a sender on a domain you verified in Resend, e.g. "GradifyForge <hello@gradifyforge.com>"
CONTACT_FROM_EMAIL=
